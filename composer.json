{
  "name": "sabri/file-25-global-visual-experience",
  "description": "File 25 global design system, public profiles, federated timelines, responsive refinement, reusable components, and native optional profile-section adapters for the Sabri Social Homeopathy Platform.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "scripts": {
    "test": [
      "@php tests/run.php",
      "@php tests/profile-data.php",
      "@php tests/file21-provider.php",
      "@php tests/design-system.php",
      "@php tests/content-cards.php",
      "@php tests/section-providers.php",
      "@php tests/section-provider-metadata.php",
      "@php tests/file06-knowledge-provider.php",
      "@php tests/safe-mode.php",
      "@php tools/verify-structure.php",
      "@php tools/verify-file06-and-components.php"
    ],
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
  }
}
